# Copy to .env.production and supply a separate, persistent production key.
# Set DJANGO_ENV=production in the service process environment.

# Stripe live API key and the signing secret for this deployment's webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_FINGERPRINT_KEY=
# Live one-time KRW price for the 1,000-credit top-up.
STRIPE_PRICE_ID=
# Live recurring KRW prices, billed every 1, 3 or 6 months.
STRIPE_PLAN_PRICE_ID_1M=
STRIPE_PLAN_PRICE_ID_3M=
STRIPE_PLAN_PRICE_ID_6M=

# Supply the BACKEND public hostnames without schemes or paths.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Exact public HTTPS frontend origins for both CORS and CSRF (no wildcard/trailing slash).
DJANGO_CSRF_TRUSTED_ORIGINS=https://unigate.kr,https://www.unigate.kr,https://topiq.unigate.kr

# Set to 1 only behind a trusted platform HTTPS ingress that replaces forwarded headers.
DJANGO_TRUST_PROXY=0
# Enable redirects with a fixed public hostname; health remains reachable over HTTP.
DJANGO_SSL_REDIRECT=1
# Backend public hostname, not the frontend hostname.
DJANGO_SSL_HOST=

# PostgreSQL connection; keep passwords out of version control.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=prefer

# S3 database backup. Enable the daily 03:00 KST schedule after a manual restore drill.
DB_BACKUP_SCHEDULE_ENABLED=0
DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_PREFIX=unigate/prod
AWS_DEFAULT_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in runtime secrets if needed.
# Temporary AWS credentials also require AWS_SESSION_TOKEN.

# Use a verified Brevo sender; supply the API key as a runtime secret.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TOPIQ
TOPIQ_PUBLIC_URL=https://topiq.unigate.kr

# Optional: same HTTPS CloudFront origin as Hub; blank disables vocabulary audio.
CLOUDFRONT_BASE_URL=
# Optional TOPIQ web OAuth client ID (Google Auth Platform).
GOOGLE_CLIENT_ID=


# GA4 keys
TOPIQ_GA4_API_SECRET=j2oFSFS1SWyz2u49Clo_Rw
TOPIQ_GA4_DEBUG=0