# Copy to .env.production and supply a separate, persistent production key.
# Set DJANGO_ENV=production in the service process environment.
# Supply the BACKEND public hostnames without schemes or paths.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Exact public HTTPS frontend origins for both CORS and CSRF (no wildcard/trailing slash).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to 1 only behind a trusted platform HTTPS ingress that replaces forwarded headers.
DJANGO_TRUST_PROXY=0
# Enable redirects with a fixed public hostname; health remains reachable over HTTP.
DJANGO_SSL_REDIRECT=1
# Backend public hostname, not the frontend hostname.
DJANGO_SSL_HOST=

# PostgreSQL connection; keep passwords out of version control.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=prefer
