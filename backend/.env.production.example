# Copy to .env.production and supply a separate, persistent production key.
# Set DJANGO_ENV=production in the service process environment.
# Supply comma-separated production hostnames without schemes or paths.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Public HTTPS frontend origin, e.g. https://www.example.com (no trailing slash).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Combined deployment: PUBLIC_SCHEME=https and trusted Nginx headers.
DJANGO_TRUST_PROXY=1
# Enable redirects with a fixed public hostname; health remains reachable over HTTP.
DJANGO_SSL_REDIRECT=1
DJANGO_SSL_HOST=
