# Copy to .env.production and fill every required value. Select with DJANGO_ENV=production.
# .env.production으로 복사하고 필수 값을 입력합니다. DJANGO_ENV=production으로 선택합니다.
# Never reuse development credentials or the development secret key.
# 개발용 접속 정보나 비밀 키를 운영에 재사용하지 않습니다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
