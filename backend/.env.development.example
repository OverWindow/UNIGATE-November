# Copy to .env.development and supply a development-only secret key.
# DJANGO_ENV defaults to development; select it in the process environment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# PostgreSQL connection; keep passwords out of version control.
DB_NAME=unigate_test
DB_USER=unigate
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSLMODE=prefer

# Brevo transactional API credentials stay on the Django server.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TOPIQ
TOPIQ_PUBLIC_URL=http://localhost:3001

