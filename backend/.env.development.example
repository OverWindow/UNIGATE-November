# Copy to .env.development. Select with DJANGO_ENV=development (the default).
# .env.development로 복사합니다. DJANGO_ENV=development로 선택하며 기본 환경입니다.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=unigate_dev
POSTGRES_USER=unigate
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
