# Copy to .env.development and supply a development-only secret key.
# DJANGO_ENV defaults to development; select it in the process environment.

# Stripe sandbox API key and the signing secret from the local Stripe CLI listener.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_FINGERPRINT_KEY=
# Sandbox one-time KRW price for the 1,000-credit top-up.
STRIPE_PRICE_ID=
# Sandbox recurring KRW prices, billed every 1, 3 or 6 months.
STRIPE_PLAN_PRICE_ID_1M=
STRIPE_PLAN_PRICE_ID_3M=
STRIPE_PLAN_PRICE_ID_6M=

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# PostgreSQL connection; keep passwords out of version control.
DB_NAME=unigate_test
DB_USER=unigate
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSLMODE=prefer

# Brevo transactional API credentials stay on the Django server.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TOPIQ
TOPIQ_PUBLIC_URL=http://localhost:3001


# Optional: same HTTPS CloudFront origin as Hub; blank disables vocabulary audio.
CLOUDFRONT_BASE_URL=
# Optional TOPIQ web OAuth client ID (Google Auth Platform).
GOOGLE_CLIENT_ID=

# GA4 keys
TOPIQ_GA4_API_SECRET=
TOPIQ_GA4_DEBUG=0