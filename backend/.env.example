# This legacy example and .env are not loaded.
# Copy .env.development.example to .env.development for local development.
# Copy .env.production.example to .env.production for production.
# Select DJANGO_ENV in the process environment, not inside these files.
# Existing process variables take precedence. Never commit real secrets.

# Optional: same HTTPS CloudFront origin as Hub; blank disables vocabulary audio.
CLOUDFRONT_BASE_URL=
