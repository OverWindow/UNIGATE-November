# Copy to .env.production for a local Next.js build, or set before npm run build.
# Docker: pass --build-arg NEXT_PUBLIC_BACKEND_URL=https://api.example.com
# Public browser URL, not an internal service address. Never include secrets.
# Changing this value requires rebuilding; runtime container ENV is not enough.
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
